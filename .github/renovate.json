{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "nix": {
    "enabled": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": [
        "^lib/mcp\\.nix$"
      ],
      "matchStrings": [
        "--from\\s+(?<depName>[A-Za-z0-9_.-]+)==(?<currentValue>[^\\s\"')]+)"
      ],
      "datasourceTemplate": "pypi",
      "versioningTemplate": "pep440"
    }
  ]
}
