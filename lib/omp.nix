{
  inputs,
  lib,
  pkgs,
}:
let
  llmAgents = inputs.llm-agents.packages.${pkgs.stdenv.hostPlatform.system};

  yamlFormat = pkgs.formats.yaml { };

  inherit (lib)
    escapeShellArg
    filterAttrs
    mapAttrs'
    mapAttrsToList
    nameValuePair
    optionalAttrs
    optionalString
    recursiveUpdate
    ;

  mkOmpConfig =
    {
      theme ? { },
      symbolPreset ? "unicode",
      defaultThinkingLevel ? "high",
      hideThinkingBlock ? false,
      terminal ? { },
      display ? { },
      steeringMode ? "one-at-a-time",
      followUpMode ? "one-at-a-time",
      interruptMode ? "immediate",
      compaction ? { },
      skills ? { },
      memories ? { },
      temperature ? -1,
      topP ? -1,
      topK ? -1,
      minP ? -1,
      modelRoles ? { },
      enabledModels ? [ ],
      modelProviderOrder ? [ ],
      disabledProviders ? [ ],
      retry ? { },
      edit ? { },
      read ? { },
      lsp ? { },
      bashInterceptor ? { },
      shellMinimizer ? { },
      branchSummary ? { },
      contextPromotion ? { },
      autoResume ? false,
      marketplace ? { },
      statusLine ? { },
      extensions ? [ ],
      disabledExtensions ? [ ],
      extraConfig ? { },
    }:
    let
      defaultTheme = {
        dark = "titanium";
        light = "light";
      };
      defaultTerminal = {
        showImages = true;
      };
      defaultDisplay = {
        tabWidth = 3;
      };
      defaultCompaction = {
        enabled = true;
        reserveTokens = 16384;
        keepRecentTokens = 20000;
        autoContinue = true;
        strategy = "context-full";
        remoteEnabled = true;
        thresholdPercent = -1;
        thresholdTokens = -1;
      };
      defaultSkills = {
        enabled = true;
      };
      defaultMemories = {
        enabled = false;
      };
      defaultRetry = {
        enabled = true;
        maxRetries = 3;
      };
      defaultModelRoles = {
        default = "claude-sonnet-4-6";
        smol = "claude-haiku-4-5";
      };
      defaultEnabledModels = [
        "anthropic/*"
        "openai/*"
      ];
      defaultModelProviderOrder = [
        "anthropic"
        "openai"
      ];
      defaultEdit = {
        mode = "hashline";
        fuzzyMatch = true;
        blockAutoGenerated = true;
      };
      defaultRead = {
        lineNumbers = false;
        hashLines = true;
        defaultLimit = 500;
      };
      defaultLsp = {
        enabled = true;
        formatOnWrite = false;
        diagnosticsOnWrite = true;
      };
      defaultBashInterceptor = {
        enabled = false;
      };
      defaultShellMinimizer = {
        enabled = true;
      };
      defaultBranchSummary = {
        enabled = false;
      };
      defaultContextPromotion = {
        enabled = true;
      };
      defaultMarketplace = {
        autoUpdate = "notify";
      };
    in
    recursiveUpdate {
      theme = recursiveUpdate defaultTheme theme;
      inherit symbolPreset defaultThinkingLevel hideThinkingBlock;
      terminal = recursiveUpdate defaultTerminal terminal;
      display = recursiveUpdate defaultDisplay display;
      inherit steeringMode followUpMode interruptMode;
      compaction = recursiveUpdate defaultCompaction compaction;
      skills = recursiveUpdate defaultSkills skills;
      memories = recursiveUpdate defaultMemories memories;
      inherit
        temperature
        topP
        topK
        minP
        ;
      retry = recursiveUpdate defaultRetry retry;
      modelRoles = recursiveUpdate defaultModelRoles modelRoles;
      enabledModels = if enabledModels != [ ] then enabledModels else defaultEnabledModels;
      modelProviderOrder =
        if modelProviderOrder != [ ] then modelProviderOrder else defaultModelProviderOrder;
      inherit disabledProviders;
      edit = recursiveUpdate defaultEdit edit;
      read = recursiveUpdate defaultRead read;
      lsp = recursiveUpdate defaultLsp lsp;
      bashInterceptor = recursiveUpdate defaultBashInterceptor bashInterceptor;
      shellMinimizer = recursiveUpdate defaultShellMinimizer shellMinimizer;
      branchSummary = recursiveUpdate defaultBranchSummary branchSummary;
      contextPromotion = recursiveUpdate defaultContextPromotion contextPromotion;
      inherit autoResume;
      marketplace = recursiveUpdate defaultMarketplace marketplace;
      statusLine = statusLine;
      inherit extensions disabledExtensions;
    } extraConfig;

  mkOmpModels =
    {
      providers ? { },
      equivalence ? { },
    }:
    filterAttrs (_: v: v != { } && v != [ ]) {
      providers = if providers != { } then providers else { };
      equivalence = if equivalence != { } then equivalence else { };
    };

  mkOmpWrapper =
    profile: runMode:
    let
      commandName = if runMode then profile.runCommandName else profile.commandName;
      configDir = if profile.configDir != null then profile.configDir else ".omp";
      envVars = profile.env or { };
      envFileVars = profile.envFiles or { };
      package = if profile ? package && profile.package != null then profile.package else llmAgents.omp;
    in
    pkgs.writeShellApplication {
      name = commandName;
      runtimeInputs = [ package ] ++ (profile.extraRuntimePackages or [ ]);
      text = ''
        export PI_CONFIG_DIR=${escapeShellArg configDir}
      ''
      + lib.concatMapStrings (k: ''
        # shellcheck disable=SC2016
        export ${k}=${escapeShellArg envVars.${k}}
      '') (builtins.attrNames envVars)
      + lib.concatMapStrings (k: ''
        ${k}="$(< ${escapeShellArg envFileVars.${k}})"
        export ${k}
      '') (builtins.attrNames envFileVars)
      + ''

        exec ${lib.getExe package} "$@"
      '';
    };

  permissionGateHook = ''
    import type { HookAPI } from "oh-my-pi"

    var BLOCKED_PATTERNS: RegExp[] = [
      /\brm\s+(-[^\s]*r[^\s]*\s|-[^\s]*rf\s)/i,
      /\bsudo\b/i,
      /\bchmod\s+(-R\s+)?777\b/i,
      /\bchown\s+(-R\s+)?root\b/i,
      /\bmkfs\b/i,
      /\bdd\s+if=/i,
      /\b:(){ :|:& };:/,
      /\bwget\s+.*\|\s*(ba)?sh\b/i,
      /\bcurl\s+.*\|\s*(ba)?sh\b/i,
    ]

    var BLOCKED_COMMANDS: string[] = [
      "reboot",
      "shutdown",
      "poweroff",
      "halt",
    ]

    export default function (pi: HookAPI) {
      pi.on("tool_call", function (call, ctx) {
        if (call.tool !== "bash" && call.tool !== "shell") return

        var command = String(call.input?.command ?? "")
        if (!command) return

        for (var i = 0; i < BLOCKED_PATTERNS.length; i++) {
          if (BLOCKED_PATTERNS[i].test(command)) {
            ctx.reject("Permission gate blocked: command matches dangerous pattern")
            return
          }
        }

        var firstWord = command.trim().split(/\s+/)[0] ?? ""
        if (BLOCKED_COMMANDS.includes(firstWord)) {
          ctx.reject("Permission gate blocked: " + firstWord + " is not allowed")
        }
      })
    }
  '';

  protectedPathsHook = ''
    import type { HookAPI } from "oh-my-pi"

    const PROTECTED_GLOBS = [
      ".env",
      ".env.*",
      ".git/**",
      "node_modules/**",
      ".direnv/**",
      ".devenv/**",
      ".omp/**",
    ]

    function matchesProtected(fp: string): boolean {
      for (const glob of PROTECTED_GLOBS) {
        if (glob.endsWith("/**")) {
          const prefix = glob.slice(0, -3)
          if (fp === prefix || fp.startsWith(prefix + "/")) return true
        } else {
          if (fp === glob) return true
        }
      }
      return false
    }

    export default (pi: HookAPI) => {
      pi.on("tool_call", (call, { reject }) => {
        if (call.tool !== "write" && call.tool !== "edit" && call.tool !== "filesystem_write_file") return

        const fp = String(call.input?.filePath ?? call.input?.path ?? "")
        if (matchesProtected(fp)) {
          reject("Protected path: writing to " + fp + " is blocked")
        }
      })
    }
  '';

  hooks = {
    permissionGate = permissionGateHook;
    protectedPaths = protectedPathsHook;
  };

  mkYamlConfig =
    profile:
    let
      config = mkOmpConfig profile;
      models = mkOmpModels profile;
    in
    {
      "agent/config.yml".text = yamlFormat.generate "omp-config" config;
      "agent/models.yml".text = yamlFormat.generate "omp-models" models;
    };

  mkHookFile =
    profileName: hookName: hookContent:
    nameValuePair "${profileName}/agent/extensions/${hookName}.ts" { text = hookContent; };

  mkProfileHookFiles =
    profileName: enabledHooks:
    builtins.listToAttrs (
      mapAttrsToList (hookName: _: mkHookFile profileName hookName hooks.${hookName}) (
        filterAttrs (_: enabled: enabled) enabledHooks
      )
    );

in
{
  inherit
    hooks
    mkOmpConfig
    mkOmpModels
    mkOmpWrapper
    mkYamlConfig
    mkProfileHookFiles
    ;

  configSuffix = "agent";
}
